* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.service text eol=lf
*.cs text eol=lf
*.gsc text eol=lf linguist-language=GSC
*.menu text eol=lf
*.inc text eol=lf
*.csv text eol=lf
*.hlsl text eol=lf
*.svg text eol=lf

# WEAPONFILE notetrack data contains literal trailing spaces and blank lines.
# Preserve the original definitions for exact gameplay-field comparison.
src/weapons/** -whitespace
art/weapons/base-definitions/** -whitespace

# Include extensionless binary engine assets.
assets/** filter=lfs diff=lfs merge=lfs -text linguist-generated=true
*.png filter=lfs diff=lfs merge=lfs -text
art/weapons/**/*.gif filter=lfs diff=lfs merge=lfs -text
art/source-images/*.iwi filter=lfs diff=lfs merge=lfs -text
server/bin/** filter=lfs diff=lfs merge=lfs -text
server/apx-cod4x-source.zip filter=lfs diff=lfs merge=lfs -text
tools/iwi2dds.exe filter=lfs diff=lfs merge=lfs -text

# View the repository masthead without an LFS download.
docs/images/** -filter -diff -merge -text
