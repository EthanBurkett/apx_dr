// Generated by tools/generate_base_weapon_shaders.py. Native gameTime only.
sampler2D colorMapSampler : register(s0);
samplerCUBE reflectionProbeSampler : register(s1);
sampler3D modelLightingSampler : register(s4);
float4 fogColor : register(c0);
float4 lightingLookupScale : register(c5);
struct Input {
    float4 color : COLOR0;
    float2 uv : TEXCOORD0;
    float4 normalTime : TEXCOORD1;
    float4 viewFog : TEXCOORD2;
    float3 lightCoords : TEXCOORD3;
};
float hash21(float2 p) { return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
float noise(float2 p) {
    float2 i=floor(p),f=frac(p); f=f*f*(3.0-2.0*f);
    return lerp(lerp(hash21(i),hash21(i+float2(1,0)),f.x),
                lerp(hash21(i+float2(0,1)),hash21(i+1.0),f.x),f.y);
}
float2 rotate2(float2 p,float a) { float s=sin(a),c=cos(a); return float2(c*p.x-s*p.y,s*p.x+c*p.y); }
float fresnel(Input input) { return pow(1.0-saturate(abs(dot(normalize(input.normalTime.xyz),normalize(input.viewFog.xyz)))),3.0); }
float3 finish(Input input,float3 albedo,float3 emission,float polish) {
    float3 N=normalize(input.normalTime.xyz),V=normalize(input.viewFog.xyz);
    float3 lookup=N/max(max(abs(N.x),abs(N.y)),abs(N.z));
    float3 ambient=max(tex3D(modelLightingSampler,input.lightCoords+lookup*lightingLookupScale.xyz).rgb*2.0,float3(.24,.26,.30));
    float4 probe=texCUBE(reflectionProbeSampler,reflect(-V,N));
    float rim=fresnel(input);
    float key=.45+.55*saturate(dot(N,normalize(float3(.35,-.45,.82))));
    float3 surface=albedo*(ambient+key*.32)*max(input.color.rgb,.25);
    surface+=probe.rgb*probe.a*polish*(.25+rim*.75);
    surface+=emission;
    return lerp(fogColor.rgb,surface,input.viewFog.w);
}

// STORMCOIL / branching arcs, advancing charge packets, dark carbon electrodes.
float4 ps_main(Input input) : COLOR0 {
    float2 uv=input.uv;float t=input.normalTime.w;
    float3 stock=tex2D(colorMapSampler,uv).rgb;
    float kink=noise(float2(uv.x*29.0,t*2.7))-.5;
    float path=.5+.14*sin(uv.x*18.0+t*.8)+kink*.22;
    float dist=abs(frac(uv.y*3.0)-path);
    float width=max(fwidth(uv.y*3.0),.0015);
    float arc=1.0-smoothstep(width,width*2.8,dist);
    float glow=exp(-dist*48.0);
    float branchDist=abs(frac(uv.y*3.0+uv.x*.6)-(.48+kink*.4));
    float branch=(1.0-smoothstep(width*.5,width*1.6,branchDist))*step(.3,sin(uv.x*41.0-t*1.8));
    float packet=pow(saturate(.5+.5*sin(uv.x*14.0-t*4.1)),10.0);
    float carbon=.55+.45*step(.5,frac((uv.x+uv.y)*150.0));
    float3 albedo=stock*float3(.13,.18,.24)*carbon;
    float3 emission=float3(.12,.8,1.6)*(arc*1.25+branch*1.1+glow*.5);
    emission+=float3(1.15,1.25,1.4)*(arc+branch)*packet*1.3;
    emission+=float3(.05,.2,.32)*fresnel(input);
    return float4(finish(input,albedo,emission,.6),1.0);
}
