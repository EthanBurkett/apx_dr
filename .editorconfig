root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# Preserve existing Windows-1252 localization and credits.
[*.{gsc,cfg,str,menu,inc}]
charset = unset

[*.md]
trim_trailing_whitespace = false
